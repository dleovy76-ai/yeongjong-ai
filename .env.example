# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://yeongjong:yeongjong@localhost:5432/yeongjong_ai
DATABASE_TEST_URL=postgresql+psycopg://yeongjong:yeongjong@localhost:5432/yeongjong_ai_test

# Cache
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-real-env-use-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM providers (fill in whichever you actually use; LLMProvider abstraction picks by config)
# NOTE: if GEMINI_API_KEY is also set as a Windows/OS environment variable, that
# silently wins over this file (pydantic-settings: env vars > .env). Check with
# `echo $GEMINI_API_KEY` / `[Environment]::GetEnvironmentVariable("GEMINI_API_KEY","User")`
# if the app seems to ignore a key you just set here.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=

# External data sources
# 공공데이터포털(data.go.kr) 소상공인시장진흥공단_상가(상권)정보_API 인증키.
# 포털에 표시된 "Decoding된 인증키"(원문, %XX 없는 형태)를 그대로 넣을 것 -
# 이미 %2F 등으로 encode된 키를 넣으면 요청 시 이중 인코딩되어 인증 실패함.
DATA_GO_KR_API_KEY=

# NAVER API HUB (console.ncloud.com) - "지역(Local)" API, used only to verify a
# business is really registered with Naver before generating a map.naver.com
# link candidate for the owner to confirm (routers/businesses.py naver_lookup).
# NOT the classic developers.naver.com key - NAVER API HUB uses a different
# domain (naverapihub.apigw.ntruss.com) and header names (X-NCP-APIGW-API-KEY*)
# than the old openapi.naver.com/X-Naver-Client-Id flow; the old-style keys
# 401 against this endpoint. Get Client ID/Secret from NAVER API HUB > 지역.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# CORS
FRONTEND_ORIGIN=http://localhost:3000
