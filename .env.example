# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://yeongjong:yeongjong@localhost:5432/yeongjong_ai
DATABASE_TEST_URL=postgresql+psycopg://yeongjong:yeongjong@localhost:5432/yeongjong_ai_test

# Cache
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-real-env-use-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM providers (fill in whichever you actually use; LLMProvider abstraction picks by config)
# NOTE: if GEMINI_API_KEY is also set as a Windows/OS environment variable, that
# silently wins over this file (pydantic-settings: env vars > .env). Check with
# `echo $GEMINI_API_KEY` / `[Environment]::GetEnvironmentVariable("GEMINI_API_KEY","User")`
# if the app seems to ignore a key you just set here.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=

# CORS
FRONTEND_ORIGIN=http://localhost:3000
